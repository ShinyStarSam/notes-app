{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "node",
        "target": "ESNext",
        "sourceMap": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "strict": true,
        "outDir": "dist",
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "ts-node": {
        "esm": true
    },
    "include": ["@types/db.d.ts"],
    "exclude": ["node_modules"],
    "lib": ["esnext"]
}
